{
    "name": "mod_manager",
    "namespace": "josephwhite",
    "description": "Mod manager menu for Y2ROLL. Adds mod enable/disable and configuration to the options menu.",
    "author": "josephwhite",
    "version_number": "1.0.0",
    "website_url": "",
    "gd_version": {
        "major": 3,
        "minor": 6
    },
    "dependencies": [],
    "extra": {
        "godot": {
            "authors": ["josephwhite"],
            "compatible_game_version": ["1.3.1"],
            "compatible_mod_loader_version": ["6.3.0"],
            "config_schema": {
                "type": "object",
                "properties": {
                    "show_version": { "type": "boolean", "default": true, "title": "Show Version" },
                    "show_author": { "type": "boolean", "default": true, "title": "Show Author" },
                    "ui_font_scale": { "type": "integer", "default": 100, "minimum": 50, "maximum": 150, "title": "UI Font Scale (%)" },
                    "mod_name_column_width": { "type": "integer", "default": 180, "minimum": 80, "maximum": 400, "title": "Mod Name Column Width" }
                }
            }
        }
    }
}
