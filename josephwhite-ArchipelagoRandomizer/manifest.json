{
  "name": "ArchipelagoRandomizer",
  "namespace": "josephwhite",
  "version_number": "0.0.4",
  "description": "Archipelago randomizer for Y2ROLL.",
  "website_url": "",
  "gd_version": {
    "major": 3,
    "minor": 6
  },
  "dependencies": [],
  "extra": {
    "godot": {
      "authors": ["josephwhite"],
      "compatible_game_version": ["1.3.1"],
      "compatible_mod_loader_version": ["6.3.0"],
      "config_schema": {
        "type": "object",
        "properties": {
          "deathlink_control": { "type": "string", "default": "Follow YAML", "enum": ["Force off", "Follow YAML", "Force on"], "title": "DeathLink" },
          "traplink_control": { "type": "string", "default": "Follow YAML", "enum": ["Force off", "Follow YAML", "Force on"], "title": "TrapLink" },
          "trap_smile": { "type": "string", "default": "Follow YAML", "enum": ["Force off", "Follow YAML", "Force on"], "title": "Smile Trap" },
          "trap_grayscale": { "type": "string", "default": "Follow YAML", "enum": ["Force off", "Follow YAML", "Force on"], "title": "Grayscale Trap" },
          "trap_oversaturation": { "type": "string", "default": "Follow YAML", "enum": ["Force off", "Follow YAML", "Force on"], "title": "Oversaturation Trap" },
          "trap_minimap": { "type": "string", "default": "Follow YAML", "enum": ["Force off", "Follow YAML", "Force on"], "title": "Minimap Trap" },
          "trap_taunt": { "type": "string", "default": "Follow YAML", "enum": ["Force off", "Follow YAML", "Force on"], "title": "Taunt Trap" },
          "trap_taunt_max": { "type": "integer", "default": 3, "minimum": 1, "maximum": 8, "title": "Max Taunt Stack" }
        }
      }
    }
  }
}